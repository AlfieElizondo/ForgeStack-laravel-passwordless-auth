{
    "name": "forge-stack/laravel-passwordless-auth",
    "description": "Passwordless sign-in for Laravel: single-use email links, rate-safe confirmation and trusted devices, with pluggable subject directories and access policies.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "authentication", "passwordless", "magic-link"],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/events": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "ForgeStack\\PasswordlessAuth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ForgeStack\\PasswordlessAuth\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ForgeStack\\PasswordlessAuth\\PasswordlessAuthServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
